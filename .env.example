# Shared local development — copy to .env (never commit .env)

# Postgres (Docker Compose default)
DATABASE_URL=postgres://tgwealth:tgwealth@localhost:5432/tgwealthvault?sslmode=disable

# Go API
API_ADDR=:8080
API_BASE_URL=http://localhost:8080
APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Bootstrap admin (created on first migrate/seed if no users exist)
ADMIN_EMAIL=admin@tgwealthvault.local
ADMIN_PASSWORD=ChangeMeNow!123
ADMIN_NAME=Admin

# Optional alerts (leave empty locally)
RESEND_API_KEY=
ALERT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080
